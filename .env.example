# Tillflow POS - copy to .env.local and fill in. Never commit real values.

# --- App / hosting (Vercel or Hostinger) ---
# Public URL of the deployed app (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Local: `pnpm supabase status`. Cloud: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never expose to the browser (dashboard > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres via pooler (dashboard > Connect > Transaction pooler); used by the app
DATABASE_URL=
# Direct connection (dashboard > Connect > Direct); used by drizzle-kit migrations
DIRECT_URL=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials; also set in Supabase Auth > Providers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Google" button. Leave false until the OAuth client above exists and is set in Supabase.
AUTH_GOOGLE_ENABLED=false

# --- Resend (resend.com > API Keys; verify the tillflow.ie sending domain) ---
RESEND_API_KEY=
EMAIL_FROM=Tillflow <no-reply@tillflow.ie>

# --- Sentry (sentry.io > Project Settings > Client Keys / Auth Tokens) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Upstash Redis for rate limits (console.upstash.com > database > REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Inngest background jobs (app.inngest.com > Manage > Event key / Signing key) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Bank details printed on subscription invoices (your business bank account) ---
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_BIC=
BANK_NAME=
