# --- App / hosting ---
# Public URL of the deployed app (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Which environment this is: development | ci | staging | production
NEXT_PUBLIC_APP_ENV=development

# --- Supabase ---
# Local: `pnpm supabase status`. Cloud: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never expose to the browser (dashboard > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres via pooler (dashboard > Connect > Transaction pooler); used by the app
DATABASE_URL=
# Direct connection (dashboard > Connect > Direct); used by drizzle-kit migrations
DIRECT_URL=

# --- Background jobs, rate limits, error log, health check ---
# Supabase SESSION pooler (port 5432), user tillflow_ops.<project-ref>. Locally: same value as DIRECT_URL.
JOBS_DATABASE_URL=
# Set to false to stop this instance running the job worker
JOBS_ENABLED=true

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials; also set in Supabase Auth > Providers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Google" button. Leave false until the OAuth client above exists and is set in Supabase.
AUTH_GOOGLE_ENABLED=false

# --- Email over SMTP (nodemailer). For now a Gmail account with 2-step verification + an app password ---
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (default), 587 = STARTTLS
SMTP_PORT=465
# The Gmail address
SMTP_USER=tline.ireland@gmail.com
# Gmail APP PASSWORD (16 characters, myaccount.google.com > Security > App passwords), never the account password
SMTP_PASS=qilxyeaduukcldge
# Error alerts and daily digest. ALERT_FROM must be the SMTP account's own address on Gmail.
ALERT_EMAIL=tline.ireland@gmail.com
ALERT_FROM=Tillflow Alerts <tline.ireland@gmail.com> 
# Receipts and invites (later steps)
EMAIL_FROM=Tillflow <no-reply@tillflow.ie>

# --- Bank details printed on subscription invoices (your business bank account) ---
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# Optional: debug | info | warn | error
LOG_LEVEL=info